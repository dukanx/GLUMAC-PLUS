SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:postgresql://localhost:5432/food_ordering
DB_USERNAME=postgres
DB_PASSWORD=postgres
# Flyway je vlasnik šeme — Hibernate samo proverava poklapanje sa entitetima.
# Postavi na "update" samo ako namerno želiš da Hibernate sam menja šemu lokalno.
JPA_DDL_AUTO=validate
HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect
JWT_SECRET=REPLACE_WITH_BASE64_SECRET
JWT_EXPIRATION_MS=2592000000
APP_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:5173,http://127.0.0.1:5173
APP_TIMEZONE=Europe/Belgrade
